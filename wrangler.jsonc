{
    "name": "miladoyle",
    "main": "worker.js",
    "compatibility_date": "2025-03-25",
    "assets": {
      "directory": "./dist",
      "binding": "ASSETS"
    },
    "r2_buckets": [
      { "binding": "ARTWORK_BUCKET", "bucket_name": "miladoyle-artwork" }
    ],
    "kv_namespaces": [
      { "binding": "ARTWORK_KV", "id": "1ebfdaf753704940b1e038644efe2d08" }
    ]
  }
